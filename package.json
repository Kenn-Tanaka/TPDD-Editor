{
  "name": "tpdd-editor",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "prepare:config": "node scripts/prepare-runtime-config.mjs",
    "predev": "npm run prepare:config",
    "dev": "vite",
    "prebuild": "npm run prepare:config",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve:dist": "node scripts/serve-dist.mjs",
    "build:launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/launcher/build.ps1",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/build-release.ps1",
    "package:kit": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/make-build-kit.ps1"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
